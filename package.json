{
  "name": "tic-api",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "test": "bun test",
    "check": "bun check src/index.ts src/services/payouts.ts src/services/demo.ts src/corredor/index.ts src/db/seed.ts scripts/fixtures.ts scripts/keys.ts scripts/sdn-update.ts",
    "fixtures": "bun run scripts/fixtures.ts",
    "keys": "bun run scripts/keys.ts",
    "sdn:update": "bun run scripts/sdn-update.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait db && bun run db:migrate && bun run db:seed",
    "db:logs": "docker compose logs -f db",
    "db:psql": "docker compose exec db sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "unpdf": "^1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.11",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9"
  }
}
