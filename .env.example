# Postgres container (used by docker-compose.yml)
POSTGRES_USER=tic
POSTGRES_PASSWORD=tic
POSTGRES_DB=tic
POSTGRES_PORT=5432

# Connection string used by the app, migrations and drizzle-kit
DATABASE_URL=postgres://tic:tic@localhost:5432/tic

# As-of date the demo starts on (read by db:seed into settings.demo_as_of)
DEMO_DEFAULT_AS_OF=2026-10-17

# Browser origin allowed to call the API
WEB_ORIGIN=http://localhost:8080

# Rail adapter: mock | bridge | blindpay. Default mock so the demo never
# depends on an external rail (only switch once a sandbox is approved).
RAIL_MODE=mock
# BRIDGE_API_KEY=
# BRIDGE_API_URL=https://api.bridge.xyz/v0/transfers
# BLINDPAY_API_KEY=

# Audit chain keys (ARCHITECTURE §12). Generate with: bun run keys
# Never commit real values; keep them in your secrets store.
AUDIT_HMAC_KEY=
AUDIT_SIGNING_KEY=
AUDIT_PUBLIC_KEY=

# Integration tests (test/payouts.test.ts) run against this database only. Create it once:
#   docker compose exec db psql -U tic -d postgres -c "CREATE DATABASE tic_test"; DATABASE_URL=$TEST_DATABASE_URL bun run db:migrate
TEST_DATABASE_URL=postgres://tic:tic@localhost:5432/tic_test

# Agent LLM: a local model in Ollama (DECISIONS D12). `ollama pull llama3.1:8b` once.
LLM_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434
LLM_NUM_CTX=8192
LLM_TIMEOUT_MS=90000
